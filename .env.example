# Copy to .env if you want to override a default. Never commit .env.
#
# This course has NO secrets: no API keys, no accounts with billing, no cloud. The .env habit is taught in
# stage 5 (environment variables) because every job has one; the only variables the course itself reads are below.

# ---- Stage 3 onward: the fixture ------------------------------------------
# Where the generated library world lives. `just data` writes it here. Leave as is unless you moved it.
LIBRARY_DATA_DIR=data/library

# ---- Stage 5: environment variables rung --------------------------------
# Used only by the stage-5 exercise that reads configuration from the environment.
LIBRARY_NAME=Northcote Neighbourhood Library
LOAN_DAYS=21

# ---- Stage 6: the public API ---------------------------------------------
# Set to 1 to make the stage-6 HTTP rung read data/library/openlibrary_sample.json instead of the network.
LIBRARY_OFFLINE=0
